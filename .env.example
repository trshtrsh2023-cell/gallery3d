# رابط ومفاتيح مشروع Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxx
# مفتاح service_role السري — لا تضعه أبداً في كود يصل للمتصفح، يُستخدم فقط في API routes على الخادم
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx

# سر توقيع جلسة الأدمن (JWT) — غيّره لقيمة عشوائية طويلة قبل النشر
ADMIN_JWT_SECRET=change-this-to-a-long-random-string
